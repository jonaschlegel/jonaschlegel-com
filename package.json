    "prettier": "3.9.6",
    "sharp": "^0.35.2",
    "stylelint": "^17.13.0",
    "stylelint-config-upleveled": "^2.0.5",
    "tailwindcss": "^4.3.1",
    "typescript": "^6.0.3"
